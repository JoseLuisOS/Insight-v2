# Intersel Insight — variables de entorno.
# Copia este archivo a `.env.local` y rellena con valores reales.
# NUNCA commitees `.env.local`. En Vercel, configura estas variables en el dashboard del proyecto.

# --- Supabase (cliente, expuestas al browser) ---
# Project ref: kytvxyjvnxamqdrhwezw (region us-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://kytvxyjvnxamqdrhwezw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (servidor, NUNCA exponer al browser) ---
