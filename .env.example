# Intersel Insight — variables de entorno.
# Copia este archivo a `.env` (o `.env.local`) y rellena con valores reales.
# NUNCA commitees el archivo con valores reales. En Vercel, configura estas variables
# en el dashboard del proyecto.

# --- Base de datos única (Supabase) ---
# Ver docs/ARQUITECTURA.md — proyecto compartido, schema `intersel_insight`.
CENTRAL_DB_SCHEMA=intersel_insight

# Conexión de administración (rol `postgres`). SOLO para tareas puntuales de DBA
# (crear roles, otorgar acceso entre esquemas). La app NUNCA se conecta con esto.
CENTRAL_DATABASE_URL=
CENTRAL_DATABASE_POOLER=

# Conexión de la aplicación (rol maestro `intersel_insight_app`, NOSUPERUSER, dueño
# del schema `intersel_insight`). Esto es lo que usan la app y las migraciones.
APP_DATABASE_URL=
APP_DATABASE_POOLER=

# --- Supabase (cliente, expuestas al browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (servidor, NUNCA exponer al browser) ---
# Sólo para operaciones administrativas del lado servidor (ingesta, snapshots).
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
