# Intersel Insight — variables de entorno.
# Copia este archivo a `.env` (o `.env.local`) y rellena con valores reales.
# NUNCA commitees el archivo con valores reales. En Vercel, configura estas variables
# en el dashboard del proyecto.

# --- Base de datos única (Supabase) ---
# Schemas propios: insight_core, insight_iam e insight_survey.
# El schema auth pertenece a Supabase.

# Conexión de administración (rol `postgres`). SOLO para tareas puntuales de DBA
# (crear roles, otorgar acceso entre esquemas). La app NUNCA se conecta con esto.
CENTRAL_DATABASE_URL=
CENTRAL_DATABASE_POOLER=

# Conexión SQL de la plataforma (rol `insight_app`, sin privilegios de DBA).
# Es dueño de los schemas propios; las tareas SQL la usan por defecto.
# El runtime Next.js usa Supabase Auth/Data API y sus claves de abajo.
APP_DATABASE_URL=
APP_DATABASE_POOLER=
# Predeterminado: 4 en desarrollo, 2 en producción.
INSIGHT_DB_POOL_MAX=
INSIGHT_SLOW_LOG_MS=1000

# --- Supabase (cliente, expuestas al browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (servidor, NUNCA exponer al browser) ---
# Sólo para operaciones administrativas del lado servidor (ingesta, snapshots).
SUPABASE_SERVICE_ROLE_KEY=

# --- App / dev local ---
# dev_local.py levanta `next dev --experimental-https` en este puerto (certificado
# autofirmado). Debe coincidir con NEXT_PUBLIC_SITE_URL para que los links de
# confirmación/reset de Supabase Auth apunten al lugar correcto.
NEXT_PUBLIC_SITE_URL=https://localhost:4102
PORT=4102
